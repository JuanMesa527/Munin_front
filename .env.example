# ============================================================================
#  perfilador-vivienda-frontend — variables de entorno
# ============================================================================
#  Copia a `.env.local` (esta en .gitignore).
#
#  AVISO DE SEGURIDAD: en Vite, TODO lo que empiece por `VITE_` se INCRUSTA en
#  el bundle publico. Nunca pongas aqui una API key, un secreto ni una llave de
#  LLM: cualquiera puede leerlas con "ver codigo fuente". Los secretos viven
#  SOLO en el backend (regla 20).
# ============================================================================

# Base de la API. Vacio = usa el proxy de Vite en dev (mismo origen, la cookie
# httpOnly del closer viaja bien). En produccion: https://<tu-backend>
VITE_API_BASE_URL=

# Muestra el banner de "demo de hackathon" y los datos semilla.
VITE_DEMO_MODE=true
